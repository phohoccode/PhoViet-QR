{
  "name": "qr-ordering-pv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "scripts": {
    "predev": "node scripts/bootstrap-owner.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/bootstrap-owner.mjs",
    "start": "next start",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "vitest run --config tests/auth/vitest.config.mts",
    "test:db": "vitest run --config tests/db/vitest.config.mts",
    "test:http": "node tests/db/http-smoke.mjs",
    "supabase:start": "supabase start -x realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:seed": "node supabase/seed-local.mjs"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@payos/node": "2.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
