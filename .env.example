# Supabase development project only. Leave empty until that project is configured.
# These two values are public browser configuration, never service-role secrets.
# The publishable key is the recommended key type for future SDK integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required when OWNER_BOOTSTRAP_ENABLED=true.
# Never add NEXT_PUBLIC_ to this variable or to any future payment/provider secret.
SUPABASE_SERVICE_ROLE_KEY=

# Trusted startup task (npm run dev / npm run start), never a public signup route.
# Set true and fill these locally to create an owner once. Existing passwords stay unchanged.
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_STORE_ID=c0200000-0000-4000-8000-000000000001
OWNER_BOOTSTRAP_STORE_NAME=Phở Việt

# P2-C01: server-only AES-256-GCM keyring. Generate 32 random bytes per key (base64).
# Example shape only: {"v1":"<32-byte-base64-key>"}; never commit real key material.
TABLE_SESSION_ENCRYPTION_KEYS=
TABLE_SESSION_ACTIVE_KEY_ID=v1
# P2-HF01: a SEPARATE server-only HMAC pepper ring, canonical base64 32-byte keys.
# AES-GCM above is reused for PIN ciphertext; do not reuse those bytes as pepper.
# Both active keys are validated when the Next Node server starts.
TABLE_PIN_HMAC_KEYS=
TABLE_PIN_ACTIVE_HMAC_KEY_ID=v1
# Optional fixed canonical origin behind reverse proxies (e.g. https://example.com).
APP_ORIGIN=
# P2-C04: canonical PUBLIC app origin for printed QR URLs. Required for owner
# table/QR management; HTTPS in production. No path/query/hash/credentials.
# Development example: http://localhost:3000 (never inferred from request Host).
APP_BASE_URL=
# Enable only behind a proxy that overwrites X-Forwarded-For. Vercel is detected.
TRUST_PROXY_IP=false
# P6 rate windows/counts are shared, admin-managed PostgreSQL configuration:
# public.capacity_rate_policy (migration 017), not a per-instance in-memory map.
# Defaults and admin/deployment notes: docs/handoffs/P6_C02_CODEX_LOAD_RATE_LIMIT_ADMISSION_REPORT.md

# P4-C01 payOS. Server-only; fill from the same payOS payment channel.
# Never prefix these variables with NEXT_PUBLIC_. Never commit real credentials.
PAYOS_CLIENT_ID=
PAYOS_STORE_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Receiving bank account linked to that channel (used to verify signed events).
PAYOS_ACCOUNT_NUMBER=
# Fixed return origin, without trailing slash/path. HTTPS required in production.
# Local example: http://localhost:3000. Browser returns never confirm payment.
PAYMENT_RETURN_ORIGIN=
# Random >=32-character server secret for the authenticated reconciliation job.
PAYMENT_RECONCILE_SECRET=

# OWNER HF01: server-only random >=32 characters for Vercel Cron image cleanup.
# Local/manual cleanup POST can use PAYMENT_RECONCILE_SECRET instead.
CRON_SECRET=

# P4-C03 pickup: two independent server-only 32-byte base64 keyrings.
# Shape: {"v1":"<32-byte-base64-key>"}. Retain old keys for existing orders/replays.
# Never reuse table PIN/session keys or prefix with NEXT_PUBLIC_.
PICKUP_ENCRYPTION_KEYS=
PICKUP_ACTIVE_ENCRYPTION_KEY_ID=v1
PICKUP_HMAC_KEYS=
PICKUP_ACTIVE_HMAC_KEY_ID=v1

# P1-C03: SSR clients are created per request/use, using only the public key.
# Dashboard/login need a reachable DEV Auth/API and an admin-created membership.
# No client is initialized at module import; static placeholder builds need no key.
# Local Supabase scripts/setup: docs/integration/P1_C03_PHASE2_READINESS.md
# Owner bootstrap: docs/integration/P1_C02_AUTH_HANDOFF.md
# Service role is not used by application auth or RLS checks in P1-C02.
