# Supabase development project only. Leave empty until that project is configured.
# These two values are public browser configuration, never service-role secrets.
# The publishable key is the recommended key type for future SDK integration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required when OWNER_BOOTSTRAP_ENABLED=true.
# Never add NEXT_PUBLIC_ to this variable or to any future payment/provider secret.
SUPABASE_SERVICE_ROLE_KEY=

# Trusted startup task (npm run dev / npm run start), never a public signup route.
# Set true and fill these locally to create an owner once. Existing passwords stay unchanged.
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_STORE_ID=c0200000-0000-4000-8000-000000000001
OWNER_BOOTSTRAP_STORE_NAME=Phở Việt

# P2-C01: server-only AES-256-GCM keyring. Generate 32 random bytes per key (base64).
# Example shape only: {"v1":"<32-byte-base64-key>"}; never commit real key material.
TABLE_SESSION_ENCRYPTION_KEYS=
TABLE_SESSION_ACTIVE_KEY_ID=v1
# Optional fixed canonical origin behind reverse proxies (e.g. https://example.com).
APP_ORIGIN=
# Enable only behind a proxy that overwrites X-Forwarded-For. Vercel is detected.
TRUST_PROXY_IP=false

# P1-C03: SSR clients are created per request/use, using only the public key.
# Dashboard/login need a reachable DEV Auth/API and an admin-created membership.
# No client is initialized at module import; static placeholder builds need no key.
# Local Supabase scripts/setup: docs/integration/P1_C03_PHASE2_READINESS.md
# Owner bootstrap: docs/integration/P1_C02_AUTH_HANDOFF.md
# Service role is not used by application auth or RLS checks in P1-C02.
